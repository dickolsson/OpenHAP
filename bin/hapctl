#!/usr/bin/env perl
use v5.36;
use Getopt::Long qw(:config no_ignore_case);
use FindBin      qw($RealBin);
use lib "$RealBin/../lib";

use FuguLib::Config;
use FuguLib::Pidfile;
use OpenHAP::DeviceLoader;
use OpenHAP::Storage;

# Default configuration
my $config_file = '/etc/openhapd.conf';

GetOptions(
	'c|config=s' => \$config_file,
	'h|help'     => \&usage,
) or usage();

my $command = shift @ARGV // 'help';

my %commands = (
	check   => \&cmd_check,
	status  => \&cmd_status,
	devices => \&cmd_devices,
	help    => \&usage,
);

if ( exists $commands{$command} ) {
	$commands{$command}->();
}
else {
	die "Unknown command: $command\n";
}

# cmd_check():
#	Validate the configuration file syntax.
sub cmd_check()
{
	my $config = load_config() or exit 1;

	my @devices = OpenHAP::DeviceLoader->devices($config);
	printf "Configuration file %s is valid\n", $config_file;
	printf "  Configured devices: %d\n",       scalar @devices;

	exit 0;
}

# cmd_status():
#	Show the daemon status and the pairing information.
sub cmd_status()
{
	my $pid =
	    FuguLib::Pidfile->new( path => '/var/run/openhapd.pid' )
	    ->is_running;

	if ( defined $pid ) {
		printf "openhapd is running (PID %d)\n", $pid;
	}
	else {
		print "openhapd is not running\n";
	}

	# Check the pairing status from storage
	my $db_path = get_db_path();
	unless ( -d $db_path ) {
		print "Pairing status: not initialized\n";
		exit 0;
	}

	# The read can fail on a directory that the caller may not read.
	# That is not a crash, it is an answer the tool cannot give.
	my $pairings = eval {
		OpenHAP::Storage->new( db_path => $db_path )->load_pairings;
	};
	if ( $@ || !$pairings ) {
		print "Pairing status: unknown (cannot read storage)\n";
		exit 0;
	}

	my $count = scalar keys %$pairings;
	if ($count) {
		printf "Pairing status: paired (%d controller%s)\n",
		    $count, $count == 1 ? '' : 's';
	}
	else {
		print "Pairing status: not paired\n";
		print "Use Home app to pair with setup code\n";
	}

	exit 0;
}

# cmd_devices():
#	List the configured devices from the configuration file.
sub cmd_devices()
{
	my $config = load_config() or exit 1;

	my @devices = OpenHAP::DeviceLoader->devices($config);

	if ( @devices == 0 ) {
		print "No devices configured\n";
		exit 0;
	}

	printf "Configured devices: %d\n\n", scalar @devices;

	for my $device (@devices) {
		my $type    = $device->{type}    // 'unknown';
		my $subtype = $device->{subtype} // 'unknown';
		my $name    = $device->{name}    // '<unnamed>';
		my $topic   = $device->{topic}   // '<no topic>';
		my $id      = $device->{id}      // '<no id>';

		printf "  %s\n",             $name;
		printf "    Type:  %s/%s\n", $type, $subtype;
		printf "    Topic: %s\n",    $topic;
		printf "    ID:    %s\n",    $id;
		print "\n";
	}

	exit 0;
}

# load_config():
#	Parse the configuration file. An absent file is normal on a
#	fresh install and gives empty settings. A file that exists but
#	does not parse is an error that names the line, and the
#	function returns nothing.
sub load_config()
{
	my $config = FuguLib::Config->new( file => $config_file );
	return $config unless -f $config_file;

	unless ( $config->load ) {
		print STDERR 'Configuration error: ' . $config->error . "\n";
		return;
	}

	return $config;
}

# get_db_path():
#	Get the database path from the config, or use the default.
sub get_db_path()
{
	my $config = load_config() or return '/var/db/openhapd';

	return $config->get( 'db_path', '/var/db/openhapd' );
}

sub usage()
{
	print STDERR <<EOF;
Usage: hapctl [options] <command>

Commands:
    check      Validate configuration file
    status     Show daemon status and pairing information
    devices    List configured devices
    help       Show this help

Options:
    -c, --config FILE    Configuration file (default: /etc/openhapd.conf)
    -h, --help           Show this help

See hapctl(8) for more information.

EOF
	exit 1;
}
