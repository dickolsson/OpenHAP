# The OpenHAP website, built by fuguweb(1).
#
# The file describes the site. It holds no list that the tree already
# holds: a manuals or modules group globs its directory, and every
# file in the source directory that is not a body fragment is an asset.

site       = OpenHAP
out_dir    = web/build
source_dir = web
entry      = index.html

# Six navigation entries, in the order the site shows them.
nav "index.html" {
	label = OpenHAP
}

nav "install.html" {
	label = Install
}

nav "manuals.html" {
	label = Manuals
}

nav "fuguvm.html" {
	label = FuguVM
}

nav "fugu.html" {
	label = Fugu
}

nav "https://github.com/dickolsson/openhap" {
	label = GitHub
}

# The pages. A page names one source: a body fragment in the source
# directory, a Markdown file, or the generated manual index.
page "index.html" {
	title = HomeKit Accessory Protocol for OpenBSD
	body  = index.body.html
}

page "404.html" {
	title = Not found
	body  = 404.body.html

	# The host serves this page for an unknown path, so no page
	# links to it.
	unlinked = yes
}

page "install.html" {
	title    = Install
	markdown = INSTALL.md
}

page "manuals.html" {
	title = Manuals
	index = yes
}

page "fuguvm.html" {
	title = FuguVM
	body  = fuguvm.body.html
}

page "fugu.html" {
	title = Fugu
	body  = fugu.body.html
}

# The manual groups. A manuals block globs its directory for the mdoc
# sources; a modules block finds the POD sidecars below its own. The
# order of the blocks is the order of the index.
manuals "OpenHAP" {
	dir    = man/openhap
	anchor = openhap
}

manuals "FuguVM" {
	dir    = man/fuguvm
	anchor = fuguvm
}

manuals "Fugu" {
	dir       = man/fugu
	anchor    = fugu

	# A Fugu source drops the prefix, because a colon cannot appear
	# in a make target. The page and the staged file keep it.
	namespace = "Fugu::"
}

# Never name lib/App here. That one directory holds three namespaces,
# and one group would swallow all of them.
modules "OpenHAP modules" {
	dir    = lib/App/OpenHAP
	anchor = modules
}

modules "Protocol modules" {
	dir    = lib/Protocol
	anchor = protocol-modules
}

modules "FuguVM modules" {
	dir    = lib/App/FuguVM
	anchor = vm-modules
}

modules "FuguWeb modules" {
	dir    = lib/App/FuguWeb
	anchor = web-modules
}
